# Terraform state and generated files
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json

# Credentials and private keys
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials
.aws/
secrets/

# Ansible sensitive files
ansible/inventory/*.ini
ansible/inventory/*.json
ansible/**/ec2_output.json
ansible/**/inventory.ini

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# IDE and operating system files
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
!**/.env.example

# JavaScript test/build output
**/node_modules/
**/coverage/
**/.nyc_output/

# Python test/build output
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/

# Java / Maven build output
**/target/

# Local test and tool reports
trivy-reports/
*.log

# Local Terraform backend configuration
terraform/backend.hcl
