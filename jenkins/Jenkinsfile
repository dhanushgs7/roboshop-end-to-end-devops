pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        booleanParam(
            name: 'PUSH_IMAGES',
            defaultValue: false,
            description: 'Push successfully built images to this AWS account ECR repositories'
        )
        booleanParam(
            name: 'DEPLOY_TO_EKS',
            defaultValue: false,
            description: 'Deploy the pushed images to the configured EKS cluster'
        )
    }

    environment {
        AWS_REGION = 'us-east-1'
        EKS_CLUSTER_NAME = 'roboshop-dev'
        K8S_NAMESPACE = 'roboshop'
        IMAGE_PREFIX = 'roboshop'
        SERVICES = 'catalogue user cart payment shipping dispatch frontend mongodb mysql'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_SHORT_SHA = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()
                    env.IMAGE_TAG = "${BUILD_NUMBER}-${GIT_SHORT_SHA}"
                }
            }
        }

        stage('Payment Unit Tests') {
            steps {
                sh '''
                    set -eu
                    docker run --rm \
                      -v "$WORKSPACE/docker/payment:/app" \
                      -w /app \
                      python:3.9-slim \
                      sh -c "python -m pip install --no-cache-dir Flask requests pika prometheus_client opentracing instana && python -m unittest discover --start-directory tests --pattern 'test_*.py' --verbose"
                '''
            }
        }

        stage('Shipping Unit Tests') {
            steps {
                sh '''
                    set -eu
                    docker run --rm \
                      -v "$WORKSPACE/docker/shipping:/app" \
                      -w /app \
                      maven:3.9.9-eclipse-temurin-17 \
                      mvn --batch-mode --no-transfer-progress test
                '''
            }
        }

        stage('User Unit Tests') {
            steps {
                sh '''
                    set -eu
                    docker run --rm \
                      -v "$WORKSPACE/docker/user:/app" \
                      -w /app \
                      node:20-alpine \
                      npm test
                '''
            }
        }

        stage('Cart Unit Tests') {
            steps {
                sh '''
                    set -eu
                    docker run --rm \
                      -v "$WORKSPACE/docker/cart:/app" \
                      -w /app \
                      node:20-alpine \
                      npm test
                '''
            }
        }

        stage('Node.js Source Validation') {
            steps {
                sh '''
                    set -eu
                    for service in catalogue user cart; do
                      docker run --rm \
                        -v "$WORKSPACE/docker/$service:/app" \
                        -w /app \
                        node:20-alpine \
                        sh -c 'find . -maxdepth 1 -type f -name "*.js" -print0 | xargs -0 -r -n1 node --check'
                    done
                '''
            }
        }

        stage('Validate Compose') {
            steps {
                sh '''
                    set -eu
                    docker --version
                    docker compose version
                    test -f docker/.env.example
                    docker compose --env-file docker/.env.example -f docker/docker-compose.yml config --quiet
                '''
            }
        }

        stage('Build Application Images') {
            steps {
                sh '''
                    set -eu
                    docker compose --env-file docker/.env.example -f docker/docker-compose.yml build
                    for service in $SERVICES; do
                      docker image inspect "joindevops/$service:v1" >/dev/null
                    done
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    set -eu
                    command -v trivy >/dev/null 2>&1 || {
                      echo "Trivy is required on the Jenkins agent."
                      exit 1
                    }
                    mkdir -p trivy-reports
                    for service in $SERVICES; do
                      image="joindevops/$service:v1"
                      trivy image --ignore-unfixed --severity HIGH,CRITICAL \
                        --exit-code 1 --format json --output "trivy-reports/$service.json" "$image"
                    done
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-reports/*.json', allowEmptyArchive: true
                }
            }
        }

        stage('Push Images to ECR') {
            when {
                expression { params.PUSH_IMAGES }
            }
            steps {
                sh '''
                    set -eu
                    command -v aws >/dev/null 2>&1
                    AWS_ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"
                    ECR_REGISTRY="$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com"
                    aws ecr get-login-password --region "$AWS_REGION" |
                      docker login --username AWS --password-stdin "$ECR_REGISTRY"

                    for service in $SERVICES; do
                      repository="$IMAGE_PREFIX/$service"
                      aws ecr describe-repositories --repository-names "$repository" --region "$AWS_REGION" >/dev/null 2>&1 ||
                        aws ecr create-repository --repository-name "$repository" --image-scanning-configuration scanOnPush=true --region "$AWS_REGION" >/dev/null
                      docker tag "joindevops/$service:v1" "$ECR_REGISTRY/$repository:$IMAGE_TAG"
                      docker push "$ECR_REGISTRY/$repository:$IMAGE_TAG"
                    done
                '''
            }
        }

        stage('Deploy to EKS') {
            when {
                expression { params.DEPLOY_TO_EKS }
            }
            steps {
                sh '''
                    set -eu
                    if [ "$PUSH_IMAGES" != "true" ]; then
                      echo "DEPLOY_TO_EKS requires PUSH_IMAGES=true in the same build."
                      exit 1
                    fi
                    command -v kubectl >/dev/null 2>&1
                    AWS_ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"
                    ECR_REGISTRY="$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com"
                    aws eks update-kubeconfig --region "$AWS_REGION" --name "$EKS_CLUSTER_NAME"
                    # Render source-controlled image references to this build's ECR tag before applying.
                    # This avoids briefly starting trainer-owned joindevops images.
                    RENDERED_MANIFESTS="$(mktemp -d)"
                    trap 'rm -rf "$RENDERED_MANIFESTS"' EXIT
                    cp -R kubernetes/. "$RENDERED_MANIFESTS/"
                    find "$RENDERED_MANIFESTS" -type f -name '*.yaml' \
                      -exec sed -i -E "s#image: joindevops/([^:]+):v1#image: $ECR_REGISTRY/$IMAGE_PREFIX/\\1:$IMAGE_TAG#g" {} +

                    if grep -R -nE 'image: *joindevops/' "$RENDERED_MANIFESTS"; then
                      echo "A trainer image reference remains in the rendered manifests; refusing deployment."
                      exit 1
                    fi

                    # Namespaces are created once by a cluster administrator; Jenkins receives
                    # namespace-scoped EKS access only and cannot query cluster-scoped Namespace objects.
                    # Secret lookups below also fail safely if a namespace or secret is missing.
                    kubectl -n "$K8S_NAMESPACE" get secret mysql-credentials >/dev/null || {
                      echo "Missing namespace $K8S_NAMESPACE or secret mysql-credentials. Ask a cluster administrator to create them."
                      exit 1
                    }
                    kubectl -n "$K8S_NAMESPACE" get secret rabbitmq-credentials >/dev/null || {
                      echo "Missing namespace $K8S_NAMESPACE or secret rabbitmq-credentials. Ask a cluster administrator to create them."
                      exit 1
                    }

                    # Monitoring is internal-only and requires a pre-created secret with its password key.
                    kubectl -n monitoring get secret grafana-admin >/dev/null || {
                      echo "Create the grafana-admin secret in namespace monitoring before enabling EKS deployment."
                      exit 1
                    }
                    grafana_password="$(kubectl -n monitoring get secret grafana-admin -o 'jsonpath={.data.admin-password}')"
                    test -n "$grafana_password" || {
                      echo "grafana-admin is missing the admin-password key."
                      exit 1
                    }
                    for key in MYSQL_ROOT_PASSWORD MYSQL_PASSWORD DB_PASSWORD; do
                      value="$(kubectl -n "$K8S_NAMESPACE" get secret mysql-credentials -o "jsonpath={.data.$key}")"
                      test -n "$value" || { echo "mysql-credentials is missing key $key"; exit 1; }
                    done
                    for key in RABBITMQ_DEFAULT_USER RABBITMQ_DEFAULT_PASS; do
                      value="$(kubectl -n "$K8S_NAMESPACE" get secret rabbitmq-credentials -o "jsonpath={.data.$key}")"
                      test -n "$value" || { echo "rabbitmq-credentials is missing key $key"; exit 1; }
                    done

                    # Start backing services first and wait for them before deploying dependants.
                    kubectl apply -n "$K8S_NAMESPACE" -f "$RENDERED_MANIFESTS/database/"
                    kubectl apply -n "$K8S_NAMESPACE" -f "$RENDERED_MANIFESTS/redis.yaml"
                    kubectl apply -n "$K8S_NAMESPACE" -f "$RENDERED_MANIFESTS/rabbitmq.yaml"

                    for service in mongodb mysql redis rabbitmq; do
                      kubectl -n "$K8S_NAMESPACE" rollout status "deployment/$service" --timeout=5m
                    done

                    kubectl apply -n "$K8S_NAMESPACE" -f "$RENDERED_MANIFESTS/catalogue.yaml"
                    kubectl apply -n "$K8S_NAMESPACE" -f "$RENDERED_MANIFESTS/user.yaml"
                    kubectl apply -n "$K8S_NAMESPACE" -f "$RENDERED_MANIFESTS/cart.yaml"
                    kubectl apply -n "$K8S_NAMESPACE" -f "$RENDERED_MANIFESTS/shipping.yaml"
                    kubectl apply -n "$K8S_NAMESPACE" -f "$RENDERED_MANIFESTS/payment.yaml"
                    kubectl apply -n "$K8S_NAMESPACE" -f "$RENDERED_MANIFESTS/dispatch.yaml"
                    kubectl apply -n "$K8S_NAMESPACE" -f "$RENDERED_MANIFESTS/frontend.yaml"
                    kubectl apply -n "$K8S_NAMESPACE" -f "$RENDERED_MANIFESTS/frontend-ingress.yaml"

                    for service in catalogue user cart shipping payment dispatch frontend; do
                      kubectl -n "$K8S_NAMESPACE" rollout status "deployment/$service" --timeout=5m
                    done

                    kubectl apply -f monitoring/kubernetes/monitoring-stack.yaml
                    kubectl -n monitoring rollout status deployment/prometheus --timeout=5m
                    kubectl -n monitoring rollout status deployment/grafana --timeout=5m
                '''
            }
        }
    }

    post {
        success {
            echo "RoboShop pipeline completed. Image tag: ${env.IMAGE_TAG}"
        }
        failure {
            echo 'RoboShop pipeline failed. Review the failed stage and archived reports.'
        }
    }
}
