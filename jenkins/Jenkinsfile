pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        booleanParam(
            name: 'PUSH_IMAGES',
            defaultValue: false,
            description: 'Push successfully built images to this AWS account ECR repositories'
        )
        booleanParam(
            name: 'UPDATE_GITOPS',
            defaultValue: false,
            description: 'Publish the pushed image tags to the GitOps branch for Argo CD reconciliation'
        )
    }

    environment {
        AWS_REGION = 'us-east-1'
        IMAGE_PREFIX = 'roboshop'
        GITOPS_BRANCH = 'gitops'
        GITOPS_REPOSITORY_URL = 'https://github.com/dhanushgs7/roboshop-end-to-end-devops.git'
        SERVICES = 'catalogue user cart payment shipping dispatch frontend mongodb mysql'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_SHORT_SHA = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()
                    env.IMAGE_TAG = "${BUILD_NUMBER}-${GIT_SHORT_SHA}"
                }
            }
        }

        stage('Payment Unit Tests') {
            steps {
                sh '''
                    set -eu
                    docker run --rm \
                      -v "$WORKSPACE/docker/payment:/app" \
                      -w /app \
                      python:3.11-slim \
                      sh -c "python -m pip install --no-cache-dir Flask requests pika opentracing instana && python -m unittest discover --start-directory tests --pattern 'test_*.py' --verbose"
                '''
            }
        }

        stage('Shipping Unit Tests') {
            steps {
                sh '''
                    set -eu
                    docker run --rm \
                      -v "$WORKSPACE/docker/shipping:/app" \
                      -w /app \
                      maven:3.9.9-eclipse-temurin-17 \
                      mvn --batch-mode --no-transfer-progress test
                '''
            }
        }

        stage('Dispatch Unit Tests') {
            steps {
                sh '''
                    set -eu
                    docker run --rm \
                      -v "$WORKSPACE/docker/dispatch:/app" \
                      -w /app \
                      golang:1.26.10-bookworm \
                      sh -c "go mod download && go test -race -cover ./..."
                '''
            }
        }

        stage('User Unit Tests') {
            steps {
                sh '''
                    set -eu
                    docker run --rm \
                      -v "$WORKSPACE/docker/user:/app" \
                      -w /app \
                      node:22-alpine \
                      npm test
                '''
            }
        }

        stage('Cart Unit Tests') {
            steps {
                sh '''
                    set -eu
                    docker run --rm \
                      -v "$WORKSPACE/docker/cart:/app" \
                      -w /app \
                      node:20-alpine \
                      npm test
                '''
            }
        }

        stage('Node.js Source Validation') {
            steps {
                sh '''
                    set -eu
                    for service in catalogue user cart; do
                      docker run --rm \
                        -v "$WORKSPACE/docker/$service:/app" \
                        -w /app \
                        node:20-alpine \
                        sh -c 'find . -maxdepth 1 -type f -name "*.js" -print0 | xargs -0 -r -n1 node --check'
                    done
                '''
            }
        }

        stage('Validate Compose') {
            steps {
                sh '''
                    set -eu
                    docker --version
                    docker compose version
                    test -f docker/.env.example
                    docker compose --env-file docker/.env.example -f docker/docker-compose.yml config --quiet
                '''
            }
        }

        stage('Build Application Images') {
            steps {
                sh '''
                    set -eu
                    docker compose --env-file docker/.env.example -f docker/docker-compose.yml build
                    for service in $SERVICES; do
                      docker image inspect "joindevops/$service:v1" >/dev/null
                    done
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    set -eu
                    command -v trivy >/dev/null 2>&1 || {
                      echo "Trivy is required on the Jenkins agent."
                      exit 1
                    }
                    mkdir -p trivy-reports
                    for service in $SERVICES; do
                      image="joindevops/$service:v1"
                      trivy image --ignore-unfixed --severity HIGH,CRITICAL \
                        --exit-code 1 --format json --output "trivy-reports/$service.json" "$image"
                    done
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-reports/*.json', allowEmptyArchive: true
                }
            }
        }

        stage('Push Images to ECR') {
            when {
                expression { params.PUSH_IMAGES }
            }
            steps {
                sh '''
                    set -eu
                    command -v aws >/dev/null 2>&1
                    AWS_ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"
                    ECR_REGISTRY="$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com"
                    aws ecr get-login-password --region "$AWS_REGION" |
                      docker login --username AWS --password-stdin "$ECR_REGISTRY"

                    for service in $SERVICES; do
                      repository="$IMAGE_PREFIX/$service"
                      aws ecr describe-repositories --repository-names "$repository" --region "$AWS_REGION" >/dev/null 2>&1 ||
                        aws ecr create-repository --repository-name "$repository" --image-scanning-configuration scanOnPush=true --region "$AWS_REGION" >/dev/null
                      docker tag "joindevops/$service:v1" "$ECR_REGISTRY/$repository:$IMAGE_TAG"
                      docker push "$ECR_REGISTRY/$repository:$IMAGE_TAG"
                    done
                '''
            }
        }

        stage('Update GitOps manifests') {
            when {
                expression { params.UPDATE_GITOPS }
            }
            steps {
                script {
                    if (!params.PUSH_IMAGES) {
                        error('UPDATE_GITOPS requires PUSH_IMAGES=true in the same build.')
                    }
                }
                withCredentials([string(credentialsId: 'github-gitops-token', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        set -eu
                        AWS_ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"
                        ECR_REGISTRY="$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com"

                        ASKPASS="$WORKSPACE/.git-askpass"
                        cat > "$ASKPASS" <<'ASKPASS_EOF'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\n' "x-access-token" ;;
  *Password*) printf '%s\n' "$GITHUB_TOKEN" ;;
esac
ASKPASS_EOF
                        chmod 700 "$ASKPASS"
                        export GIT_ASKPASS="$ASKPASS"
                        export GIT_TERMINAL_PROMPT=0

                        REMOTE_REF="$(git ls-remote --heads "$GITOPS_REPOSITORY_URL" "refs/heads/$GITOPS_BRANCH")"
                        if [ -n "$REMOTE_REF" ]; then
                          git fetch "$GITOPS_REPOSITORY_URL" "refs/heads/$GITOPS_BRANCH"
                          git checkout -B "$GITOPS_BRANCH" FETCH_HEAD
                          # Bring the latest application and manifest changes from the build into GitOps.
                          git merge --no-edit "$GIT_COMMIT"
                        else
                          # First publication starts from the exact application commit built by this pipeline.
                          git checkout -B "$GITOPS_BRANCH" "$GIT_COMMIT"
                        fi

                        for service in catalogue user cart payment shipping dispatch frontend mongodb mysql; do
                          manifest="kubernetes/$service.yaml"
                          if [ "$service" = "mongodb" ] || [ "$service" = "mysql" ]; then
                            manifest="kubernetes/database/$service.yaml"
                          fi
                          test -f "$manifest" || {
                            echo "Missing expected deployment manifest: $manifest"
                            exit 1
                          }
                          sed -i "s#image: joindevops/$service:v1#image: $ECR_REGISTRY/$IMAGE_PREFIX/$service:$IMAGE_TAG#g" "$manifest"
                          grep -Fq "image: $ECR_REGISTRY/$IMAGE_PREFIX/$service:$IMAGE_TAG" "$manifest" || {
                            echo "Image reference update failed for $service in $manifest"
                            exit 1
                          }
                        done

                        if git diff --quiet -- kubernetes; then
                          echo "GitOps manifests already reference this image tag; no commit is required."
                          exit 0
                        fi

                        git config user.name "roboshop-jenkins"
                        git config user.email "roboshop-jenkins@users.noreply.github.com"
                        git add kubernetes
                        git commit -m "chore(gitops): deploy RoboShop \${IMAGE_TAG}"
                        git push "$GITOPS_REPOSITORY_URL" "HEAD:refs/heads/$GITOPS_BRANCH"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "RoboShop pipeline completed. Image tag: ${env.IMAGE_TAG}"
        }
        failure {
            echo 'RoboShop pipeline failed. Review the failed stage and archived reports.'
        }
    }
}
